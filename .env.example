# Instagram Analytics MCP Server configuration

# Required: Facebook User Access Token with permissions:
# - instagram_basic, instagram_manage_insights, pages_read_engagement, pages_show_list
# Get from: https://developers.facebook.com/tools/explorer/
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Optional: Instagram Business Account ID
# Leave empty to auto-detect or use instagram_list_accounts tool to find it
INSTAGRAM_ACCOUNT_ID=

# Optional: Instagram Graph API version (defaults to v23.0)
INSTAGRAM_API_VERSION=v23.0

# Set to enable debug logging (logs to stderr)
# DEBUG=instagram-analytics-mcp
